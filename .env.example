# GEMINI_API_KEY: Fallback AI model provider if configured
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OpenAI GPT Configuration (Required for GPT backend integration)
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# JWT Authentication
JWT_SECRET="nexus-super-secret-jwt-key-2026-production-ready"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# MySQL Database Configuration
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="nexus_ai_db"
MYSQL_USER="nexus_user"
MYSQL_PASSWORD="nexus_password"
MYSQL_ROOT_PASSWORD="root_password"
DATABASE_URL="mysql+pymysql://nexus_user:nexus_password@db:3306/nexus_ai_db"

# Google Sheets Integration
GOOGLE_SHEET_ID=""

